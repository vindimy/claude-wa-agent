# Copy to .env (gitignored). Only the variables you need.

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info
# Rolling log files (JSON lines) in addition to stdout: app.<date>.<n>.log
# with everything, errors.<date>.<n>.log with warn and above. Rotated daily
# or at 20 MB, 30 files kept per stream. Unset = stdout only (pm2 keeps its
# own files on the host). The Docker image defaults to /app/data/logs.
# LOG_DIR=./data/logs

# --- Summarizer auth, pick one -------------------------------------------
# Owner's Claude subscription, headless. Generate once with `claude setup-token`
# on any machine where `claude` is logged in. Owner-only; never share.
# CLAUDE_CODE_OAUTH_TOKEN=

# API-key adapters. SUMMARIZER forces one adapter for every group; leave it
# unset to pick adapters per group in config.yaml. Each adapter reads only
# its own key, so several can be present at once.
# SUMMARIZER=api-anthropic
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=          # GEMINI_API_KEY is accepted too

# --- Paths (defaults shown; the Docker image sets its own) ---------------
# CONFIG_PATH=./config.yaml
# DATA_DIR=./data
# VAULT_DIR=./vault

# --- Docker only -----------------------------------------------------------
# Time zone for cadences that do not set tz (the host profile uses the OS)
# TZ=America/Los_Angeles
# uid/gid that owns ./data and ./vault on the host: `id -u` / `id -g`
# PUID=1000
# PGID=1000
# Image tag to run: latest (default), a version like 0.1.0, or sha-<short>
# DIGEST_IMAGE_TAG=latest
