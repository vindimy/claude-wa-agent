# Copy to .env (gitignored). Only the variables you need.

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# --- Summarizer auth, pick one -------------------------------------------
# Owner's Claude subscription, headless. Generate once with `claude setup-token`
# on any machine where `claude` is logged in. Owner-only; never share.
# CLAUDE_CODE_OAUTH_TOKEN=

# API-key fallback: forces the api-anthropic adapter for every group.
# SUMMARIZER=api-anthropic
# ANTHROPIC_API_KEY=

# --- Paths (defaults shown; the Docker image sets its own) ---------------
# CONFIG_PATH=./config.yaml
# DATA_DIR=./data
# VAULT_DIR=./vault

# --- Docker only -----------------------------------------------------------
# Time zone for cadences that do not set tz (the host profile uses the OS)
# TZ=America/Los_Angeles
# uid/gid that owns ./data and ./vault on the host: `id -u` / `id -g`
# PUID=1000
# PGID=1000
# Image tag to run: latest (default), a version like 0.1.0, or sha-<short>
# DIGEST_IMAGE_TAG=latest
