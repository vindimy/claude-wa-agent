# Copy to .env and adjust. All paths are relative to the working directory.

# Path to the YAML config file (default: ./config.yaml)
CONFIG_PATH=./config.yaml

# Directory for SQLite DB and WhatsApp auth state (default: ./data)
DATA_DIR=./data

# pino log level: trace | debug | info | warn | error | fatal (default: info)
LOG_LEVEL=info
