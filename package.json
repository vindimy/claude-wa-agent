{
  "name": "wa-digest-agent",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "description": "WhatsApp group digest agent — listens to allow-listed groups and produces scheduled summaries",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "bin": {
    "digest": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/cli/index.ts run",
    "digest": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "format": "biome format --write src"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@google/genai": "^2.21.0",
    "baileys": "7.0.0-rc14",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "openai": "^7.10.0",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "@types/qrcode-terminal": "^0.12.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
